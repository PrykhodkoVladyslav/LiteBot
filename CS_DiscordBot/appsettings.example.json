{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },

  "Bot": {
    // Paste your Discord bot token here
    "Token": "",

    "Prefix": "=",

    "WhiteList": {
      // Set "true" to enable
      "Enabled": false,

      // Example:
      // "AllowedChannelIds": [
      //  901234567895555000,
      //  901234567895555001
      // ]
      "AllowedChannelIds": [

      ]
    },

    "IgnoreMessagesFromBots": true,

    "LogReceivedMessages": true
  }
}