{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },

  "Bot": {
    // Paste your Discord bot token here
    "Token": "",

    "Prefix": "=",

    "WhiteList": {
      // Set "true" to enable
      "Enabled": false,

      // Example:
      // "AllowedChannelIds": [
      //  901234567895555000,
      //  901234567895555001
      // ]
      "AllowedChannelIds": [

      ]
    },

    "IgnoreMessagesFromBots": true,

    "LogReceivedMessages": true,

    "StableDiffusion": {
      // URL to AUTOMATIC1111 Stable Diffusion API. The link must end with /
      "ApiUrl": "http://127.0.0.1:7860/sdapi/v1/",

      "ImageGenerationTimeoutInSeconds": 900
    }
  }
}